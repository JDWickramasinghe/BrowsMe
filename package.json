{
  "name": "browsme",
  "version": "0.7.0",
  "description": "BrowsMe, an AI-assisted Chromium browser created by J.D. Wickramasinghe and powered by DeepSeek.",
  "main": "src/main/main.js",
  "author": "Sobersided",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "test:forms": "electron scripts/form-controls-live-smoke.js",
    "test:auth": "electron scripts/authentication-live-smoke.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.browsme.browser",
    "productName": "BrowsMe",
    "copyright": "Copyright © 2026 Sobersided. Created by J.D. Wickramasinghe.",
    "icon": "build/icon.ico",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Sobersided",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Sobersided",
      "synopsis": "AI-assisted Chromium browser",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
